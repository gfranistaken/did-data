  "title": "Life Cycle Sustainment Plan (LCSP)",
  "summary": "The Life Cycle Sustainment Plan details the strategy and resources needed to support a system throughout its life, from development to disposal, ensuring effectiveness, affordability, and sustainment integration.",
  "approval_date": "2026-04-24",
